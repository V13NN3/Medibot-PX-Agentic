{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/apps/appointment",
      "regex": "^/apps/appointment(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/apps/appointment(?:/)?$"
    },
    {
      "page": "/apps/diagnostics",
      "regex": "^/apps/diagnostics(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/apps/diagnostics(?:/)?$"
    },
    {
      "page": "/apps/find-doctor",
      "regex": "^/apps/find\\-doctor(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/apps/find\\-doctor(?:/)?$"
    },
    {
      "page": "/apps/labs",
      "regex": "^/apps/labs(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/apps/labs(?:/)?$"
    },
    {
      "page": "/apps/patient",
      "regex": "^/apps/patient(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/apps/patient(?:/)?$"
    },
    {
      "page": "/apps/queue",
      "regex": "^/apps/queue(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/apps/queue(?:/)?$"
    },
    {
      "page": "/apps/rx",
      "regex": "^/apps/rx(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/apps/rx(?:/)?$"
    },
    {
      "page": "/apps/settings",
      "regex": "^/apps/settings(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/apps/settings(?:/)?$"
    },
    {
      "page": "/apps/telehealth",
      "regex": "^/apps/telehealth(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/apps/telehealth(?:/)?$"
    },
    {
      "page": "/apps/vitals",
      "regex": "^/apps/vitals(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/apps/vitals(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}