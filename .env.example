# Medibot PX — Environment Variables
# Copy this to .env.local and fill in your values.

# AI Models
GEMMA4_API_KEY=
GEMMA4_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-4:generateContent

MEDGEMMA_API_KEY=
MEDGEMMA_API_URL=https://generativelanguage.googleapis.com/v1beta/models/medgemma-1.5:generateContent

# Google Text-to-Speech
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_API_URL=https://texttospeech.googleapis.com/v1/text:synthesize

# Height measurement (Pi Camera + Grok vision estimate)
# CAMERA_ELEVATION_CM=133

# Grok Voice AI
GROK_VOICE_API_KEY=
GROK_VOICE_MODEL=grok-voice-think-fast-1.0
GROK_VOICE_API_URL=wss://api.x.ai/v1/realtime

# Grok Vision AI (image understanding: height estimate, lab results)
# Falls back to GROK_VOICE_API_KEY if not set.
# GROK_VISION_API_KEY=
# GROK_VISION_MODEL=grok-4.6

# PostgreSQL Database (Supabase)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Secure HTTPS (kiosk on LAN, needed so tablet browsers allow microphone/camera)
# PI_IP is this machine's LAN IP. The voice relay and telephony WSS URLs in the
# app are built from the browser's host, so no IP is hardcoded in code. Set
# PI_IP only so the self-signed cert's SAN matches it (server auto-regenerates
# the cert if PI_IP changes). Generate certs first: npm run gen-cert
# PI_IP=192.168.1.25
# TLS_CERT=./certs/cert.pem
# TLS_KEY=./certs/key.pem
# HTTPS_PORT=3000
