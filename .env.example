# Medibot PX — Environment Variables
# Copy this to .env.local and fill in your values.

# AI Models
GEMMA4_API_KEY=
GEMMA4_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-4:generateContent

MEDGEMMA_API_KEY=
MEDGEMMA_API_URL=https://generativelanguage.googleapis.com/v1beta/models/medgemma-1.5:generateContent

# Google Text-to-Speech
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_API_URL=https://texttospeech.googleapis.com/v1/text:synthesize

# Grok Voice AI
GROK_VOICE_API_KEY=
GROK_VOICE_MODEL=grok-voice-think-fast-1.0
GROK_VOICE_API_URL=wss://api.x.ai/v1/realtime

# PostgreSQL Database (Supabase)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[PROJECT_REF].supabase.co:5432/postgres
